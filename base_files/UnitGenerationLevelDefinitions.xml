<UnitGenerationLevelDefinitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                     xsi:noNamespaceSchemaLocation="UnitGenerationLevelDefinitions.xsd">

   <UnitGenerationLevelDefinition Id="Start">
      <Default>
         <Level>1</Level>
      </Default>
   </UnitGenerationLevelDefinition>

   <UnitGenerationLevelDefinition Id="LowUnitLevel">
      <Default>
         <Level>Random(AveragePlayableUnitLevel - 4, AveragePlayableUnitLevel - 2)</Level>
      </Default>
   </UnitGenerationLevelDefinition>

   <UnitGenerationLevelDefinition Id="HighUnitLevel">
      <Default>
         <Level>Random(AveragePlayableUnitLevel, MaxPlayableUnitLevel)</Level>
      </Default>
   </UnitGenerationLevelDefinition>

   <UnitGenerationLevelDefinition Id="AverageUnitLevel">
      <Default>
         <Level>Random(AveragePlayableUnitLevel - 2, AveragePlayableUnitLevel)</Level>
      </Default>
   </UnitGenerationLevelDefinition>

   <UnitGenerationLevelDefinition Id="LowUnitLevelApoc">
      <Default>
         <Level>Random(AveragePlayableUnitLevel - 6, AveragePlayableUnitLevel - 4)</Level>
      </Default>
   </UnitGenerationLevelDefinition>

   <UnitGenerationLevelDefinition Id="HighUnitLevelApoc">
      <Default>
         <Level>Random(AveragePlayableUnitLevel- 2, MaxPlayableUnitLevel - 2)</Level>
      </Default>
   </UnitGenerationLevelDefinition>

   <UnitGenerationLevelDefinition Id="AverageUnitLevelApoc">
      <Default>
         <Level>Random(AveragePlayableUnitLevel - 4, AveragePlayableUnitLevel - 2)</Level>
      </Default>
   </UnitGenerationLevelDefinition>

</UnitGenerationLevelDefinitions>
