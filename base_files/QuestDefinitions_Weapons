   <!--Sword-->
   <QuestDefinition Id="UniqueWeaponSword">
      <ShopCategories>
         <Category>Weapon</Category>
      </ShopCategories>
      
      <Tags>
         <Tag>UniqueWeapon</Tag>
      </Tags>
      
      <TokenVariables>
         <TokenVariable Key="Quest1Completed" Value="Quest1DealDamage > Quest1NeededDamages - 1"/>
         <TokenVariable Key="Quest1DealDamage" Value="Module.Buffer"/>
         <TokenVariable Key="Quest1NeededDamages" Value="1500"/>

         <TokenVariable Key="Quest2Completed" Value="Quest2NightsCompleted > Quest2NeededNight - 1"/>
         <TokenVariable Key="Quest2NightsCompleted" Value="Module.Buffer2"/>
         <TokenVariable Key="Quest2MaxPanicLevel" Value="1"/>
         <TokenVariable Key="Quest2NeededNight" Value="7"/>

         <TokenVariable Key="Quest3Completed" Value="Quest3SwordMove > Quest3NeededMove - 1"/>
         <TokenVariable Key="Quest3SwordMove" Value="Module.Buffer3"/>
         <TokenVariable Key="Quest3MoveBeforeCastBegin" Value="Module.Buffer4"/>
         <TokenVariable Key="Quest3NeededMove" Value="24"/>

         <TokenVariable Key="ApocMin" Value="4"/>
         <TokenVariable Key="ItemId" Value="Sword"/>
      </TokenVariables>

      <LocArguments>
         <LocArgument Value="ApocMin" Style="KeyWordNb"/>
         <LocArgument Value="Quest1NeededDamages" Style="KeyWordNb"/>
         <LocalizedArgument Prefix="WeaponCategory_" Value="ItemId" Style="KeyWord"/>
         <LocArgument Value="Quest2NeededNight" Style="KeyWordNb"/>
         <LocArgument Value="Quest3NeededMove" Style="KeyWordNb"/>
      </LocArguments>

      <Display>
         <Unlocks>
            <Unlock>
               <LocalizationKey Value="QuestUnlock1_UniqueWeaponSword"/>
            </Unlock>
         </Unlocks>
         <Requirements>
            <Title>
               <LocalizationKey Value="QuestRequirementTitle_UniqueWeaponSword"/>
            </Title>
            <Requirement>
               <IsDone Value="Quest1Completed"/>
               <Progression>
                  <CurrentValue Value="Quest1DealDamage"/>
                  <GoalValue Value="Quest1NeededDamages"/>
               </Progression>
               <LocalizationKey Value="QuestRequirement1_UniqueWeaponSword"/>
            </Requirement>
            <Requirement>
               <IsDone Value="Quest2Completed"/>
               <Progression>
                  <CurrentValue Value="Quest2NightsCompleted"/>
                  <GoalValue Value="Quest2NeededNight"/>
               </Progression>
               <LocalizationKey Value="QuestRequirement2_UniqueWeaponSword"/>
            </Requirement>
            <Requirement>
               <IsDone Value="Quest3Completed"/>
               <Progression>
                  <CurrentValue Value="Quest3SwordMove"/>
                  <GoalValue Value="Quest3NeededMove"/>
               </Progression>
               <LocalizationKey Value="QuestRequirement3_UniqueWeaponSword"/>
            </Requirement>
         </Requirements>
      </Display>

      <States>
         <UnlockedState>
            <Conditions>
               <IsTrue Value="IsMetaUpgradeActivated('UnlockSword')"/>
               <IsTrue Value="ApocalypseTierIsUnlocked('1')"/>
            </Conditions>
         </UnlockedState>
         <FulfilledState>
            <Conditions>
               <IsTrue Value="Quest1Completed"/>
               <IsTrue Value="Quest2Completed"/>
               <IsTrue Value="Quest3Completed"/>
            </Conditions>
         </FulfilledState>
      </States>

      <Effects>
         <UnlockResearch ResearchId="SwordUniqueResearch"/>
      </Effects>

      <Modules>
         <BufferModule>
            <Events>
               <!--Quest 1-->
               <Event EffectTime="OnSkillCastEnd">
                  <Conditions>
                     <IsFalse Value="Quest1Completed"/>
                     <IsTrue Value="IsAtApocalypseLevelOrMore(ApocMin)"/>
                     <IsTrue Value="Skill.IsFromItemWithTag('ItemId')"/>
                  </Conditions>
                  <Actions>
                     <SetBufferTo BufferIndex="Buffer" Value="0"/>
                  </Actions>
               </Event>
               <Event EffectTime="OnTargetHit">
                  <Conditions>
                     <IsTrue Value="IsAtApocalypseLevelOrMore(ApocMin)"/>
                     <IsTrue Value="Skill.IsFromItemWithTag('ItemId')"/>
                  </Conditions>
                  <Actions>
                     <IncreaseBuffer BufferIndex="Buffer" Value="AttackData.TotalDamage"/>
                  </Actions>
               </Event>
               <!--End Quest 1-->

               <!--Quest 2-->
               <Event EffectTime="OnNightReportAppear">
                  <Conditions>
                     <IsTrue Value="IsAtApocalypseLevelOrMore(ApocMin)"/>
                     <IsFalse Value="PanicLevel > Quest2MaxPanicLevel"/>
                     <IsTrue Value="PlayableUnitEquipWithItemWithTagCount('ItemId') > 0"/>
                  </Conditions>
                  <Actions>
                     <IncreaseBuffer BufferIndex="Buffer2" Value="1"/>
                  </Actions>
               </Event>
               <!--End Quest 2-->

               <!--Quest 3-->
               <Event EffectTime="OnSkillCastBegin">
                  <Conditions>
                     <IsFalse Value="Quest3Completed"/>
                     <IsTrue Value="IsAtApocalypseLevelOrMore(ApocMin)"/>
                     <IsTrue Value="Skill.IsFromItemWithTag('ItemId')"/>
                     <IsTrue Value="Skill.HasManeuver"/>
                  </Conditions>
                  <Actions>
                     <SetBufferTo BufferIndex="Buffer4" Value="Caster.TilesCrossedThisTurn"/>
                  </Actions>
               </Event>
               <Event EffectTime="OnSkillCastEnd">
                  <Conditions>
                     <IsFalse Value="Quest3Completed"/>
                     <IsTrue Value="IsAtApocalypseLevelOrMore(ApocMin)"/>
                     <IsTrue Value="Skill.IsFromItemWithTag('ItemId')"/>
                     <IsTrue Value="Skill.HasManeuver"/>
                  </Conditions>
                  <Actions>
                     <IncreaseBuffer BufferIndex="Buffer3" Value="Caster.TilesCrossedThisTurn - Quest3MoveBeforeCastBegin"/>
                  </Actions>
               </Event>
               <Event EffectTime="OnTargetKilled">
                  <Conditions>
                     <IsFalse Value="Quest3Completed"/>
                     <IsTrue Value="IsAtApocalypseLevelOrMore(ApocMin)"/>
                     <IsTrue Value="Skill.IsFromItemWithTag('ItemId')"/>
                     <IsTrue Value="Skill.HasFollow"/>
                  </Conditions>
                  <Actions>
                     <IncreaseBuffer BufferIndex="Buffer3" Value="DistanceFromOwnerToTarget"/>
                  </Actions>
               </Event>
               <Event EffectTime="OnStartTurn">
                  <Conditions>
                     <IsFalse Value="Quest3Completed"/>
                  </Conditions>
                  <Actions>
                     <SetBufferTo BufferIndex="Buffer3" Value="0"/>
                  </Actions>
               </Event>
               <!--End Quest 3-->
               
               <Event EffectTime="OnQuickStart">
                  <Conditions>
                     <IsTrue Value="IsMetaUpgradeActivated('UnlockSwordVariations1')"/>
                  </Conditions>
                  <Actions>
                     <IncreaseBuffer BufferIndex="Buffer2" Value="3"/>
                  </Actions>
               </Event>
               <Event EffectTime="OnQuickStart">
                  <Conditions>
                     <IsTrue Value="IsMetaUpgradeActivated('UnlockSwordVariations2')"/>
                  </Conditions>
                  <Actions>
                     <IncreaseBuffer BufferIndex="Buffer2" Value="3"/>
                     <SetBufferTo BufferIndex="Buffer" Value="Quest1NeededDamages"/>
                  </Actions>
               </Event>
            </Events>
         </BufferModule>
      </Modules>
   </QuestDefinition>
   
