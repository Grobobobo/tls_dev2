   <QuestDefinition Id="UniqueWeaponManaFlower" DLCId="Elves">
      <ShopCategories>
         <Category>Weapon</Category>
      </ShopCategories>
      
      <Tags>
         <Tag>UniqueWeapon</Tag>
      </Tags>
      
      <TokenVariables>
         <TokenVariable Key="Quest1Completed" Value="Quest1DealDamage > Quest1NeededDamages - 1"/>
         <TokenVariable Key="Quest1DealDamage" Value="Module.Buffer"/>
         <TokenVariable Key="Quest1NeededDamages" Value="2000"/>

         <TokenVariable Key="Quest2Completed" Value="Quest2NightsCompleted > Quest2NeededNight - 1"/>
         <TokenVariable Key="Quest2NightsCompleted" Value="Module.Buffer2"/>
         <TokenVariable Key="Quest2MaxPanicLevel" Value="1"/>
         <TokenVariable Key="Quest2NeededNight" Value="7"/>

         <TokenVariable Key="Quest3Completed" Value="Quest3ActualPlagueLevel > Quest3PlagueLevelToReach - 1"/>
         <TokenVariable Key="Quest3ActualPlagueLevel" Value="Module.Buffer3"/>
         <TokenVariable Key="Quest3PlagueLevelToReach" Value="45"/>
         <TokenVariable Key="Quest3PerkId" Value="LifeLoan"/>

         <TokenVariable Key="ApocMin" Value="4"/>
         <TokenVariable Key="ItemId" Value="ManaFlower"/>
      </TokenVariables>

      <LocArguments>
         <LocArgument Value="ApocMin" Style="KeyWordNb"/>
         <LocArgument Value="Quest1NeededDamages" Style="KeyWordNb"/>
         <LocalizedArgument Prefix="WeaponCategory_" Value="ItemId" Style="KeyWord"/>
         <LocArgument Value="Quest2NeededNight" Style="KeyWordNb"/>
         <LocArgument Value="Quest3PlagueLevelToReach" Style="KeyWordNb"/>
         <LocalizedArgument Prefix="PerkName_" Value="Quest3PerkId" Style="Perk"/>
      </LocArguments>

      <Display>
         <Unlocks>
            <Unlock>
               <LocalizationKey Value="QuestUnlock1_UniqueWeaponManaFlower"/>
            </Unlock>
         </Unlocks>
         <Requirements>
            <Title>
               <LocalizationKey Value="QuestRequirementTitle_UniqueWeaponManaFlower"/>
            </Title>
            <Requirement>
               <IsDone Value="Quest1Completed"/>
               <Progression>
                  <CurrentValue Value="Quest1DealDamage"/>
                  <GoalValue Value="Quest1NeededDamages"/>
               </Progression>
               <LocalizationKey Value="QuestRequirement1_UniqueWeaponManaFlower"/>
            </Requirement>
            <Requirement>
               <IsDone Value="Quest2Completed"/>
               <Progression>
                  <CurrentValue Value="Quest2NightsCompleted"/>
                  <GoalValue Value="Quest2NeededNight"/>
               </Progression>
               <LocalizationKey Value="QuestRequirement2_UniqueWeaponManaFlower"/>
            </Requirement>
            <Requirement>
               <IsDone Value="Quest3Completed"/>
               <Progression>
                  <CurrentValue Value="Quest3ActualPlagueLevel"/>
                  <GoalValue Value="Quest3PlagueLevelToReach"/>
               </Progression>
               <LocalizationKey Value="QuestRequirement3_UniqueWeaponManaFlower"/>
            </Requirement>
         </Requirements>
      </Display>

      <States>
         <UnlockedState>
            <Conditions>
               <IsTrue Value="IsMetaUpgradeActivated('UnlockManaFlower')"/>
               <IsTrue Value="ApocalypseTierIsUnlocked('2')"/>
            </Conditions>
         </UnlockedState>
         <FulfilledState>
            <Conditions>
               <IsTrue Value="Quest1Completed"/>
               <IsTrue Value="Quest2Completed"/>
               <IsTrue Value="Quest3Completed"/>
            </Conditions>
         </FulfilledState>
      </States>

      <Effects>
         <UnlockResearch ResearchId="ManaFlowerUniqueResearch"/>
      </Effects>

      <Modules>
         <BufferModule>
            <Events>
               <!--Quest 1-->
               <Event EffectTime="OnSkillCastEnd">
                  <Conditions>
                     <IsFalse Value="Quest1Completed"/>
                     <IsTrue Value="IsAtApocalypseLevelOrMore(ApocMin)"/>
                     <IsTrue Value="Skill.IsFromItemWithTag('ItemId')"/>
                  </Conditions>
                  <Actions>
                     <SetBufferTo BufferIndex="Buffer" Value="0"/>
                  </Actions>
               </Event>
               <Event EffectTime="OnTargetHit">
                  <Conditions>
                     <IsTrue Value="IsAtApocalypseLevelOrMore(ApocMin)"/>
                     <IsTrue Value="Skill.IsFromItemWithTag('ItemId')"/>
                  </Conditions>
                  <Actions>
                     <IncreaseBuffer BufferIndex="Buffer" Value="AttackData.TotalDamage"/>
                  </Actions>
               </Event>
               <!--End Quest 1-->

               <!--Quest 2-->
               <Event EffectTime="OnNightReportAppear">
                  <Conditions>
                     <IsTrue Value="IsAtApocalypseLevelOrMore(ApocMin)"/>
                     <IsFalse Value="PanicLevel > Quest2MaxPanicLevel"/>
                     <IsTrue Value="PlayableUnitEquipWithItemWithTagCount('ItemId') > 0"/>
                  </Conditions>
                  <Actions>
                     <IncreaseBuffer BufferIndex="Buffer2" Value="1"/>
                  </Actions>
               </Event>
               <!--End Quest 2-->

               <!--Quest 3-->
               <Event EffectTime="OnSkillCastEnd">
                  <Conditions>
                     <IsFalse Value="Quest3Completed"/>
                     <IsTrue Value="IsAtApocalypseLevelOrMore(ApocMin)"/>
                     <IsTrue Value="Skill.IsFromItemWithTag('ItemId')"/>
                  </Conditions>
                  <Actions>
                     <SetBufferTo BufferIndex="Buffer3" Value="Caster.GetPerkModuleBuffer('Quest3PerkId',1,1)"/>
                  </Actions>
               </Event>
               <!--End Quest 3-->

               <Event EffectTime="OnQuickStart">
                  <Conditions>
                     <IsTrue Value="IsMetaUpgradeActivated('UnlockManaFlowerVariations1')"/>
                  </Conditions>
                  <Actions>
                     <IncreaseBuffer BufferIndex="Buffer2" Value="3"/>
                  </Actions>
               </Event>
               <Event EffectTime="OnQuickStart">
                  <Conditions>
                     <IsTrue Value="IsMetaUpgradeActivated('UnlockManaFlowerVariations2')"/>
                  </Conditions>
                  <Actions>
                     <IncreaseBuffer BufferIndex="Buffer2" Value="3"/>
                     <SetBufferTo BufferIndex="Buffer" Value="Quest1NeededDamages"/>
                  </Actions>
               </Event>
            </Events>
         </BufferModule>
      </Modules>
   </QuestDefinition>
   
   
