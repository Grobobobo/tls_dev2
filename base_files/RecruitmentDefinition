      <Slot Id="3">
         <PlayableUnitGenerationDefinitions>
            <PlayableUnitGenerationDefinition ArchetypeId="Range"/>
         </PlayableUnitGenerationDefinitions>
         <UnitGenerationLevelDefinition Id="AverageUnitLevel"/>
      </Slot>
      <Slot Id="4">
         <PlayableUnitGenerationDefinitions>
            <PlayableUnitGenerationDefinition ArchetypeId="Magic"/>
         </PlayableUnitGenerationDefinitions>
         <UnitGenerationLevelDefinition Id="AverageUnitLevel"/>
      </Slot>
