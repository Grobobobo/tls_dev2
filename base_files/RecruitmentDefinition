   <UnitGenerationSettings>
      <!-- Modify here the formula with the correct values and delete this comment -->
      <!-- GeneratedLevelWithoutModifier is the level generated before we apply modifier like the new apocalypse effect (InnLevelModifier_1) -->
      <Cost>50 + Round(20 * Pow(GeneratedLevelWithoutModifier - 1, 1.25))</Cost>
