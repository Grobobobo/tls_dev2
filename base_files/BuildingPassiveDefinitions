   <BuildingPassiveDefinition Id="GenerateShopItems">

      <UpdateShopLevel/>

      <GenerateNewItemsRoster>

         <!--Weapons-->

         <CreateItem>

            <BuildingLevelModifiersList Id="ShopProduction"/>

            <ItemsList Id="ItemList_ShopSlotWeaponMelee"/>

            <ItemRaritiesList Id="ShopProduction"/>

            <Count>

               1

               + BooleanChoice(MeleeWeaponQuantity > 15, 1, 0)

            </Count>

         </CreateItem>

         <CreateItem>

            <BuildingLevelModifiersList Id="ShopProduction"/>

            <ItemsList Id="ItemList_ShopSlotWeaponRanged"/>

            <ItemRaritiesList Id="ShopProduction"/>

            <Count>

               1

               + BooleanChoice(RangedWeaponQuantity > 15, 1, 0)

            </Count>

         </CreateItem>

         <CreateItem>

            <BuildingLevelModifiersList Id="ShopProduction"/>

            <ItemsList Id="ItemList_ShopSlotWeaponMagic"/>

            <ItemRaritiesList Id="ShopProduction"/>

            <Count>

               1

               + BooleanChoice(MagicWeaponQuantity > 15, 1, 0)

            </Count>

         </CreateItem>

         <CreateItem>

            <BuildingLevelModifiersList Id="ShopProduction"/>

            <ItemsList Id="ItemList_ShopSlotWeaponAll"/>

            <ItemRaritiesList Id="ShopProduction"/>

            <Count>

               1

               + BooleanChoice(WeaponQuantity > 23, 1, 0)

               + BooleanChoice(WeaponQuantity > 59, 1, 0)

               + BooleanChoice(WeaponQuantity > 89, 1, 0)

            </Count>

         </CreateItem>

         <!--Shields / Special Offhands-->

         <CreateItem>

            <BuildingLevelModifiersList Id="ShopProduction"/>

            <ItemsList Id="ItemList_ShopSlotOffhand"/>

            <ItemRaritiesList Id="ShopProduction"/>

            <Count>1</Count>

         </CreateItem>

         <!--Armors-->

         <CreateItem>

            <BuildingLevelModifiersList Id="ShopProduction"/>

            <ItemsList Id="ItemList_ShopSlotArmorHelmet"/>

            <ItemRaritiesList Id="ShopProduction"/>

            <Count>1</Count>

         </CreateItem>

         <CreateItem>

            <BuildingLevelModifiersList Id="ShopProduction"/>

            <ItemsList Id="ItemList_ShopSlotArmorBodyArmor"/>

            <ItemRaritiesList Id="ShopProduction"/>

            <Count>1</Count>

         </CreateItem>

         <CreateItem>

            <BuildingLevelModifiersList Id="ShopProduction"/>

            <ItemsList Id="ItemList_ShopSlotArmorPants"/>

            <ItemRaritiesList Id="ShopProduction"/>

            <Count>1</Count>

         </CreateItem>

         <CreateItem>

            <BuildingLevelModifiersList Id="ShopProduction"/>

            <ItemsList Id="ItemList_ShopSlotArmorAll"/>

            <ItemRaritiesList Id="ShopProduction"/>

            <Count>

               1

               + BooleanChoice(ArmorQuantity > 23, 1, 0)

               + BooleanChoice(ArmorQuantity > 44, 1, 0)

               + BooleanChoice(ArmorQuantity > 74, 1, 0)

            </Count>

         </CreateItem>

         <!--Trinkets-->

         <CreateItem>

            <BuildingLevelModifiersList Id="ShopProduction"/>

            <ItemsList Id="ItemList_ShopSlotTrinket"/>

            <ItemRaritiesList Id="ShopProduction"/>

            <Count>

               RandomInt(1,2)

               + BooleanChoice(AllQuantity > 134, 1, 0)

               + BooleanChoice(AllQuantity > 209, 1, 0)

            </Count>

         </CreateItem>

         <!--Trinkets Perk-->

         <CreateItem Id="ShopMedalPerk" MinLevel="2">

            <BuildingLevelModifiersList Id="ShopProduction"/>

            <ItemsList Id="ItemList_ShopSlotPerkTrinket"/>

            <ItemRaritiesList Id="ShopProduction"/>

            <Count>0</Count> <!-- 0 because we want to set the correct count using meta upgrades -->

         </CreateItem>

         <!--Consumables-->

         <CreateItem Id="ShopHealPotions"> <!-- This is optional, and just an example of how we can/must id a <CreateItem> IF we want to alter it via meta upgrades -->

            <BuildingLevelModifiersList Id="ShopProduction"/>

            <ItemsList Id="ItemList_ShopSlotUsablePotionHeal"/>

            <ItemRaritiesList Id="AlwaysCommon"/>

            <Count>1</Count>

         </CreateItem>

         <CreateItem>

            <BuildingLevelModifiersList Id="ShopProduction"/>

            <ItemsList Id="ItemList_ShopSlotUsablePotionAll"/>

            <ItemRaritiesList Id="AlwaysCommon"/>

            <Count>

               2

               + BooleanChoice(AllQuantity > 149, 1, 0)

               + BooleanChoice(AllQuantity > 234, 1, 0)

            </Count>

         </CreateItem>

         <CreateItem>

            <BuildingLevelModifiersList Id="ShopProduction"/>

            <ItemsList Id="ItemList_ShopSlotUsableScroll"/>

            <ItemRaritiesList Id="AlwaysCommon"/>

            <Count>

               RandomInt(1,2)

               + BooleanChoice(AllQuantity > 179, 1, 0)

               + BooleanChoice(AllQuantity > 259, 1, 0)

            </Count>

         </CreateItem>

      </GenerateNewItemsRoster>



      <Triggers>

         <StartProductionTurn/>

         <OnConstruction/>

      </Triggers>

   </BuildingPassiveDefinition>



