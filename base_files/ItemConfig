<ItemConfig xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:noNamespaceSchemaLocation="ItemConfig.xsd">

   <AffixesCountPerRarity>
      <Rarity Id="1">0</Rarity>
      <Rarity Id="2">1</Rarity>
      <Rarity Id="3">2</Rarity>
      <Rarity Id="4">4</Rarity>
      <Rarity Id="5">0</Rarity>
   </AffixesCountPerRarity>

   <ItemPriceEquation>(BasePrice * Pow(Constant1, Rarity - 1)) + (Constant2 * Pow((Rarity - 1), PowerConstant))</ItemPriceEquation>
   <ItemPriceEquationConstant1>1.1</ItemPriceEquationConstant1>
   <ItemPriceEquationConstant2>5</ItemPriceEquationConstant2>
   <ItemPriceEquationPowerConstant>1.8</ItemPriceEquationPowerConstant>
</ItemConfig>
