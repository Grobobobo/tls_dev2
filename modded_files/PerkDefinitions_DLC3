      <PerkDefinition Id="PanicMovePoint">
         <TokenVariables>
            <TokenVariable Key="TotalMovePointGain" Value="MovepointGainPerStep * NumberOfStepsReached"/>
            <TokenVariable Key="MovepointGainPerStep" Value="1"/>
            <TokenVariable Key="ActualMoveBonus" Value="BooleanChoice(PanicValue > 99,3,0)"/>
            <TokenVariable Key="NextThresholdReachedIn" Value="((NumberOfStepsReached + 1) *StepValue) - CurrentPanic"/>
            <TokenVariable Key="NumberOfStepsReached" Value="Floor(CurrentPanic/StepValue)"/>
            <TokenVariable Key="StepValue" Value="20"/>
            <TokenVariable Key="CurrentPanic" Value="Round(PanicValue)"/>
         </TokenVariables>
         <LocArguments>
            <LocArgument Value="StepValue" Suffix="%" Style="KeyWordNb"/>
            <StatArgument Value="MovepointGainPerStep" Stat="MovePointsTotal" DisplaySign="true" Interpreted="true"/>
            <LocArgument Value="CurrentPanic" Suffix="%" Interpreted="true" Style="KeyWordNb"/>
            <StatArgument Value="TotalMovePointGain" Interpreted="true" DisplaySign="true" Stat="MovePointsTotal"/>
            <LocArgument Value="NextThresholdReachedIn" Suffix="%" Interpreted="true" Style="KeyWordNb"/>
         </LocArguments>
         <View>
            <DisplayInHUD>
               <Bonus Value="TotalMovePointGain"/>
               <GreyOut>
                  <IsFalse Value="PanicValue > 19"/>
               </GreyOut>
            </DisplayInHUD>
         </View>
         <Modules>
            <BufferModule>
               <Effects>
                  <StatModifier Stat="MovePointsTotal" Value="TotalMovePointGain" ChildStatFollows="true"/>
               </Effects>
            </BufferModule>
         </Modules>
      </PerkDefinition>

