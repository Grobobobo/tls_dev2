                  <Conditions>
                     <IsTrue Value="Skill.IsFromItemWithTag('HandCrossbowUnique')"/>
                     <IsFalse Value="HasUnitBeenKilledDuringSkillCast"/>
                     <IsTrue Value="HasSkillBeenUsedEnough"/>
                  </Conditions>
                  <Actions>
                     <TriggerEffects/>
                     <SetBufferTo BufferIndex="Buffer" Value="0"/>
                     <SetBufferTo BufferIndex="Buffer2" Value="0"/>
