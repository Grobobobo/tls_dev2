   <PerkDefinition Id="HeroesBlockPhysDamagePerk">
      <TokenVariables>
         <TokenVariable Key="BonusMultiplier" Value="Floor(BooleanChoice(Owner.PhysicalDamage-MinimumThreshold > 0, Owner.PhysicalDamage-MinimumThreshold, 0)/PhysAttackThreshold)"/>
         <TokenVariable Key="NextThreshold" Value="MinimumThreshold + (NumberOfStepsReached + 1) * PhysAttackThreshold"/>
         <TokenVariable Key="NumberOfStepsReached" Value="Floor(CurrentPhysOverThreshold / PhysAttackThreshold)"/>
         <TokenVariable Key="CurrentPhysOverThreshold" Value="Max(0, Owner.PhysicalDamage - MinimumThreshold)"/>
         <TokenVariable Key="BlockBonus" Value="10"/>
         <TokenVariable Key="PhysAttackThreshold" Value="10"/>
         <TokenVariable Key="MinimumThreshold" Value="100"/>
      </TokenVariables>
      <LocArguments>
         <LocArgument Value="PhysAttackThreshold" Suffix="%" Style="GoodNb"/>
         <StatArgument Stat="PhysicalDamage"/>
         <LocArgument Value="MinimumThreshold" Style="KeyWordNb"/>
         <StatArgument Stat="Block" Value="BlockBonus"/>
         <StatArgument Stat="Block" Value="BlockBonus * BonusMultiplier" Interpreted="true"/>
         <StatArgument Stat="PhysicalDamage" Value="NextThreshold" Interpreted="true" DisplaySign="false"/>
      </LocArguments>
      <View>
         <DisplayInHUD>
            <Bonus Value="BlockBonus * BonusMultiplier"/>
         </DisplayInHUD>
      </View>
      <Modules>
         <BufferModule>
            <Effects>
               <StatModifier Stat="Block" Value="BlockBonus * BonusMultiplier"/>
            </Effects>
         </BufferModule>
      </Modules>
   </PerkDefinition>

