   <PerkDefinition Id="CorruptedMageResearchPerk">
      <TokenVariables>
         <TokenVariable Key="ManaToSpend" Value="16"/> <!--Base: 12-->
         <TokenVariable Key="ManaSpent" Value="Module.Buffer"/>
         <TokenVariable Key="ResistanceGained" Value="90"/>
         <TokenVariable Key="HasAlreadyActivatedThisTurn" Value="Module.Buffer2 > 0"/>
         <TokenVariable Key="BuffDuration" Value="1"/>
      </TokenVariables>
      <View>
         <DisplayInHUD>
            <Buffer Value="Max(0 , (ManaToSpend - ManaSpent))"/>
            <GreyOut>
               <IsTrue Value="HasAlreadyActivatedThisTurn"/>
            </GreyOut>
         </DisplayInHUD>
      </View>
      <LocArguments>
         <LocArgument Value="ManaToSpend" Style="KeywordNb" Interpreted="true"/>
         <StatArgument Stat="ManaTotal" />
         <StatusArgument Status="Buff" Stat="Resistance" Value="ResistanceGained" TurnsCount="BuffDuration" />
         <LocArgument Value="ManaSpent" Style="Mana" Interpreted="true"/>
      </LocArguments>
      <Modules>
         <BufferModule>
            <Events>
               <Event EffectTime="OnSkillCastBegin">
                  <Actions>
                     <IncreaseBuffer BufferIndex="Buffer" Value="Skill.ManaCost"/>
                  </Actions>
               </Event>
               <Event EffectTime="OnSkillCastEnd">
                  <Conditions>
                     <IsTrue Value="ManaSpent > ManaToSpend-1"/>
                     <IsFalse Value="HasAlreadyActivatedThisTurn"/>
                  </Conditions>
                  <Actions>
                     <TriggerEffects/>
                     <SetBufferTo BufferIndex="Buffer2" Value="1"/>
                     <!--<Log Formatting="Reached cap" Value="Module.Buffer2"/>-->
                  </Actions>
               </Event>
               <Event EffectTime="OnEndTurn">
                  <Actions>
                     <SetBufferTo BufferIndex="Buffer" Value="0"/>
                     <SetBufferTo BufferIndex="Buffer2" Value="0"/>
                  </Actions>
               </Event>
            </Events>
            <Effects>
               <ApplyStatus Stat="Resistance" Status="Buff" TurnsCount="BuffDuration" Value="ResistanceGained">
                  <PerkTargeting Amount="1" Range="0" TargetingMethod="Self" TargetingReference="Owner">
                     <DamageableTarget Type="Playable"/>
                  </PerkTargeting>
               </ApplyStatus>
            </Effects>
         </BufferModule>
      </Modules>
   </PerkDefinition>

