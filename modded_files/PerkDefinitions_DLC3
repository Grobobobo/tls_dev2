         <TokenVariable Key="ActualDamageBonus" Value="BooleanChoice(IsEnemyInsideHavenThisNight=0,20,0)"/>
         <TokenVariable Key="DamageGain" Value="25"/>
         <TokenVariable Key="IsEnemyInsideHavenThisNight" Value="Module.Buffer"/>
      </TokenVariables>
      <LocArguments>
         <StatArgument Value="DamageGain" Stat="OverallDamage" DisplaySign="true" Interpreted="true"/>
      </LocArguments>
      <View>
         <DisplayInHUD>
            <GreyOut>
               <IsFalse Value="IsEnemyInsideHavenThisNight = 0"/>
            </GreyOut>
         </DisplayInHUD>
      </View>
      <Modules>
         <BufferModule>
            <Events>
               <Event EffectTime="OnEnemyMovementEnd">
