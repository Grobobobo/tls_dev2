                     <SetBufferTo BufferIndex="Buffer" Value="0"/>
                     <SetBufferTo BufferIndex="Buffer2" Value="0"/>
                  </Actions>
               </Event>
            </Events>
            <Effects>
               <RestoreStat Stat="ActionPoints" Value="ActionPointsRestoreValue"/>
            </Effects>
         </BufferModule>
      </Modules>
