   <PerkDefinition Id="WeakButDeadly">
      <TokenVariables>
         <TokenVariable Key="AccuracyPercentageMalus" Value="Max(0, AccuracyMaxBonus - (AccuracyPercentageDecrement * AccuracyMalusPerStep))"/>
         <TokenVariable Key="AccuracyPercentageDecrement" Value="Floor(CurrentHealthOverThreshold / AccuracyHealthStep)"/>
         <TokenVariable Key="RangeMalusValue" Value="Max(0, RangeMaxBonus - (RangeDecrement * RangeMalusPerStep))"/>
         <TokenVariable Key="RangeDecrement" Value="Floor(CurrentHealthOverThreshold / RangeHealthStep)"/>
         <TokenVariable Key="AccuracyNextThreshold" Value="MinimumHealthThreshold + (AccuracyNumberOfStepsReached + 1) * AccuracyHealthStep"/>
         <TokenVariable Key="RangeNextThreshold" Value="MinimumHealthThreshold + (RangeNumberOfStepsReached + 1) * RangeHealthStep"/>
         <TokenVariable Key="AccuracyNumberOfStepsReached" Value="Floor(CurrentHealthOverThreshold / AccuracyHealthStep)"/>
         <TokenVariable Key="RangeNumberOfStepsReached" Value="Floor(CurrentHealthOverThreshold / RangeHealthStep)"/>
         <TokenVariable Key="CurrentHealthOverThreshold" Value="Max(0, Owner.HealthTotal - MinimumHealthThreshold)"/>
         <TokenVariable Key="AccuracyMaxBonus" Value="20"/>
         <TokenVariable Key="RangeMaxBonus" Value="3"/>
         <TokenVariable Key="AccuracyMalusPerStep" Value="2"/>
         <TokenVariable Key="RangeMalusPerStep" Value="1"/>
         <TokenVariable Key="AccuracyHealthStep" Value="12"/>
         <TokenVariable Key="RangeHealthStep" Value="40"/>
         <TokenVariable Key="MinimumHealthThreshold" Value="125"/>
         <TokenVariable Key="MinMalusValue" Value="0"/>
      </TokenVariables>
      <LocArguments>
         <StatArgument Stat="Accuracy" Value="AccuracyMaxBonus" DisplaySign="true"/>
         <LocArgument Value="AccuracyHealthStep" Style="KeyWordNb"/>
         <StatArgument Stat="HealthTotal"/>
         <LocArgument Value="MinimumHealthThreshold"  Style="KeyWordNb"/>
         <StatArgument Value="-1 * AccuracyMalusPerStep" Stat="Accuracy" Interpreted="true" DisplaySign="true"/>
         <LocArgument Value="MinMalusValue"  Style="KeyWordNb" Suffix="%"/>
         <StatArgument Stat="SkillRangeModifier" Value="RangeMaxBonus" DisplaySign="true"/>
         <LocArgument Value="RangeHealthStep" Style="KeyWordNb"/>
         <StatArgument Stat="HealthTotal"/>
         <LocArgument Value="MinimumHealthThreshold"  Style="KeyWordNb"/>
         <StatArgument Stat="SkillRangeModifier" Value="-1 * RangeMalusPerStep" Interpreted="true" DisplaySign="true"/>
         <LocArgument Value="MinMalusValue" Style="KeyWordNb"/>
         <StatArgument Stat="Accuracy" Value="AccuracyPercentageMalus" Interpreted="true"/>
         <StatArgument Stat="HealthTotal" Value="AccuracyNextThreshold" Interpreted="true" DisplaySign="false" Style="KeyWordNb"/>
         <StatArgument Stat="SkillRangeModifier" Value="RangeMalusValue" Interpreted="true"/>
         <StatArgument Stat="HealthTotal" Value="RangeNextThreshold" Interpreted="true" DisplaySign="false" Style="KeyWordNb"/>
      </LocArguments>
      <View>
         <DisplayBonusBeforePurchase/>
         <DisplayInHUD>

         </DisplayInHUD>
      </View>
      <Modules>
         <BufferModule>
            <Effects>
               <StatModifier Stat="Accuracy" Value="AccuracyPercentageMalus"/>
               <StatModifier Stat="SkillRangeModifier" Value="RangeMalusValue"/>
            </Effects>
         </BufferModule>
      </Modules>
   </PerkDefinition>

   <PerkDefinition Id="StrongerAllies">
      <TokenVariables>
         <TokenVariable Key="MaxHealthBonus" Value="25"/>
      </TokenVariables>
      <LocArguments>
         <StatArgument Stat="HealthTotal" Value="MaxHealthBonus" DisplaySign="true"/>
         <StatArgument Stat="HealthTotal" Value="Module.Buffer" DisplaySign="true"/>
      </LocArguments>
      <View>
         <DisplayInHUD>
            <Highlight>
               <IsTrue Value="Skill.HasBuff"/>
            </Highlight>
            <Bonus Value="Module.Buffer"/>
         </DisplayInHUD>
         <CompendiumEntries>
            <CompendiumEntry Id="SkillEffect_Buff"/>
         </CompendiumEntries>
      </View>
      <Modules>
         <BufferModule>
            <Events>
               <Event EffectTime="OnStartProductionTurn">
                  <Actions>
                     <SetBufferTo BufferIndex="Buffer" Value="0"/>
                     <!--Reset buffer at the end of the night-->
                  </Actions>
               </Event>
               <Event EffectTime="OnSkillStatusApplied">
                  <Conditions>
                     <IsTrue Value="AppliedBuff"/>
                  </Conditions>
                  <Actions>
                     <IncreaseBuffer BufferIndex="Buffer" Value="MaxHealthBonus"/>
                     <!--Increase buffer each time a status is applied with a skill-->
                  </Actions>
               </Event>
            </Events>
            <Effects>
               <StatModifier Stat="HealthTotal" Value="Module.Buffer"/>
               <!--Add a permanent bonus to the hero using the buffer value-->
            </Effects>
         </BufferModule>
      </Modules>
   </PerkDefinition>

   <PerkDefinition Id="StrongerMagic">
      <TokenVariables>
         <TokenVariable Key="SkillHasManaCost" Value="ManaCostBase > 0"/>
         <TokenVariable Key="ManaCostReduction" Value="BooleanChoice(ResRedIsUpToClampPercentage, ManaCostBase * ReductionClampPercentage / 100, ManaCostBase * Owner.ResistanceReduction * 2 / 100)"/>
         <TokenVariable Key="ResRedIsUpToClampPercentage" Value="(Owner.ResistanceReduction * 2) > ReductionClampPercentage"/>
         <TokenVariable Key="ManaCostBase" Value="BooleanChoice(Owner.IsManaCostLocked, 0, Skill.BaseManaCost)"/>
         <TokenVariable Key="ReductionClampPercentage" Value="70"/>
      </TokenVariables>
      <LocArguments>
         <StatArgument Stat="ManaTotal"/>
         <StatArgument Stat="ResistanceReduction"/>
         <LocArgument Value="ReductionClampPercentage * -1" Interpreted="true" Suffix="%" Style="GoodNb"/>
         <LocArgument Value="BooleanChoice(ResRedIsUpToClampPercentage, ReductionClampPercentage, Owner.ResistanceReduction * 2)" Interpreted="true" Suffix="%" Style="GoodNb"/>

      </LocArguments>                          
      <View>
         <DisplayInHUD/>
      </View>
      <Modules>
         <BufferModule>
            <Effects>
               <SkillModifier ComputationStat="ManaCost" Value="ManaCostReduction">
                  <Conditions>
                     <IsTrue Value="SkillHasManaCost"/>
                  </Conditions>
               </SkillModifier>
            </Effects>
         </BufferModule>

      </Modules>
   </PerkDefinition>

