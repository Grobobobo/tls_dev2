                  </Conditions>
                  <Actions>
                     <DecreaseBuffer BufferIndex="Buffer2" Value="1"/>
                     <SetBufferTo BufferIndex="Buffer3" Value="1"/>
                  </Actions>
               </Event>
               <!--Revert cleanse if injured target hit-->
               <Event EffectTime="OnTargetHit">
