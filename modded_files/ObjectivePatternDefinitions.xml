<ObjectivePatternDefinitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="ObjectivePatternDefinitions.xsd">
   
   <!-- SkipNakedPatternFeasibility, if true, skips the feasibility check on a pattern when no constraint nor duration has been picked yet -->
   <!-- Min/Max diff definition: DefaultMin = 100 | DefaultMax = N/A | LowerDiffTarget = 125 | EarlyDiffTarget = 215 | UpperDiffTarget = 800-->
   <ObjectivePatternDefinition Id="KillEnemies" Weight="15" SkipNakedPatternFeasibility="true" MinDifficulty="150">
      <ObjectiveAction>KillEnemy</ObjectiveAction>
      
      <ObjectiveConstraints>
         <!-- <ObjectiveConstraint Value="None" Weight="1"/>-->
         <ObjectiveConstraint Value="EnemyId" Weight="10"/>
         <ObjectiveConstraint Value="Isolated" Weight="1"/>
         <ObjectiveConstraint Value="NegativeAlteration" Weight="1"/>
         <ObjectiveConstraint Value="XTilesFromFog" Weight="1"/>
         <ObjectiveConstraint Value="SkillCost" Weight="1"/>
         <ObjectiveConstraint Value="TargetFullHealth" Weight="1"/>
         <ObjectiveConstraint Value="WithoutMoving" Weight="1"/>
         <ObjectiveConstraint Value="XTilesOrLessFromCaster" Weight="1"/>
         <ObjectiveConstraint Value="XTilesOrMoreFromCaster" Weight="1"/>
      </ObjectiveConstraints>
      
      <AdditionalConstraintOdd>0.45</AdditionalConstraintOdd>
      
      <ObjectiveDurations>
         <ObjectiveDuration Value="Normal" Weight="1"/>
      </ObjectiveDurations>
   </ObjectivePatternDefinition>

   
