   <!--Gildenberg-->
   <QuestDefinition Id="HavenGildenberg">
      <ShopCategories>
         <Category>Economy</Category>
      </ShopCategories>
      
      <TokenVariables>
         <TokenVariable Key="Quest1Completed" Value="Quest1HighRankNights > Quest1NightsNeeded - 1"/>
         <TokenVariable Key="Quest1HighRankNights" Value="Module.Buffer"/>
         <TokenVariable Key="Quest1NightsNeeded" Value="4"/>
         <TokenVariable Key="Quest1MaxPanicLevel" Value="0"/>

         <TokenVariable Key="Quest2Completed" Value="Quest2OrdealCompleted > Quest2OrdealNeeded - 1"/>
         <TokenVariable Key="Quest2OrdealCompleted" Value="Module.Buffer2"/>
         <TokenVariable Key="Quest2OrdealNeeded" Value="5"/>
         
         <TokenVariable Key="Quest3Completed" Value="Quest3MaterialGained > Quest3MaterialNeeded - 1"/>
         <TokenVariable Key="Quest3MaterialGained" Value="Module.Buffer3"/>
         <TokenVariable Key="Quest3MaterialNeeded" Value="4000"/>

         <TokenVariable Key="ApocMin" Value="18"/>
         <TokenVariable Key="RequiredCity" Value="Felderland"/>
         <TokenVariable Key="HasBeenQuickstarted" Value="Module.Buffer4"/>
      </TokenVariables>

      <LocArguments>
         <LocArgument Value="ApocMin" Style="KeyWordNb"/>
         <LocalizedArgument Prefix="WorldMap_CityName_" Value="RequiredCity" Style="KeyWord"/>
         <LocArgument Value="Quest1NightsNeeded" Style="KeyWordNb"/>
         <LocArgument Value="Quest2OrdealNeeded" Style="KeyWordNb"/>
         <LocArgument Value="Quest3MaterialNeeded" Style="KeyWordNb"/>
      </LocArguments>

      <Display>
         <Unlocks>
            <Unlock>
               <LocalizationKey Value="QuestUnlock1_HavenGildenberg"/>
            </Unlock>
         </Unlocks>
         <Requirements>
            <Title>
               <LocalizationKey Value="QuestRequirementTitle_HavenGildenberg"/>
            </Title>
            <Requirement>
               <IsDone Value="Quest1Completed"/>
               <Progression>
                  <CurrentValue Value="Quest1HighRankNights"/>
                  <GoalValue Value="Quest1NightsNeeded"/>
               </Progression>
               <LocalizationKey Value="QuestRequirement1_HavenGildenberg"/>
            </Requirement>
            <Requirement>
               <IsDone Value="Quest2Completed"/>
               <Progression>
                  <CurrentValue Value="Quest2OrdealCompleted"/>
                  <GoalValue Value="Quest2OrdealNeeded"/>
               </Progression>
               <LocalizationKey Value="QuestRequirement2_HavenGildenberg"/>
            </Requirement>
            <Requirement>
               <IsDone Value="Quest3Completed"/>
               <Progression>
                  <CurrentValue Value="Quest3MaterialGained"/>
                  <GoalValue Value="Quest3MaterialNeeded"/>
               </Progression>
               <LocalizationKey Value="QuestRequirement3_HavenGildenberg"/>
            </Requirement>
         </Requirements>
      </Display>

      <States>
         <UnlockedState>
            <Conditions>
               <IsTrue Value="IsMetaUpgradeActivated('UnlockFelderlandCity')"/>
               <IsTrue Value="ApocalypseTierIsUnlocked('2')"/>
            </Conditions>
         </UnlockedState>
         <FulfilledState>
            <Conditions>
               <IsTrue Value="Quest1Completed"/>
               <IsTrue Value="Quest2Completed"/>
               <IsTrue Value="Quest3Completed"/>
            </Conditions>
         </FulfilledState>
      </States>

      <Effects>
         <UnlockResearch ResearchId="HavenGildenbergResearch"/>
      </Effects>

      <Modules>
         <BufferModule>
            <Events>
               <!--Quest 1-->
               <Event EffectTime="OnNightReportAppear">
                  <Conditions>
                     <IsTrue Value="IsAtApocalypseLevelOrMore(ApocMin)"/>
                     <IsTrue Value="PanicLevel = Quest1MaxPanicLevel"/>
                     <IsTrue Value="IsCityId('RequiredCity')"/>
                  </Conditions>
                  <Actions>
                     <IncreaseBuffer BufferIndex="Buffer" Value="1"/>
                  </Actions>
               </Event>
               <!--End Quest 1-->

               <!--Quest 2-->
               <Event EffectTime="OnObjectiveCompleted">
                  <Conditions>
                     <IsTrue Value="IsAtApocalypseLevelOrMore(ApocMin)"/>
                     <IsTrue Value="IsCityId('RequiredCity')"/>
                  </Conditions>
                  <Actions>
                     <IncreaseBuffer BufferIndex="Buffer2" Value="1"/>
                  </Actions>
               </Event>
               <!--End Quest 2-->

               <!--Quest 3-->
               <Event EffectTime="OnResourceGained">
                  <Conditions>
                     <IsTrue Value="IsAtApocalypseLevelOrMore(ApocMin)"/>
                     <IsTrue Value="IsCityId('RequiredCity')"/>
                     <IsTrue Value="HasResourceGained"/>
                     <IsTrue Value="ResourceGainedData.HasMaterials"/>
                  </Conditions>
                  <Actions>
                     <!--<Log Value="ResourceGainedData.MaterialsAmount" Formatting="Materials gained: {0}"/>-->
                     <IncreaseBuffer BufferIndex="Buffer3" Value="ResourceGainedData.MaterialsAmount"/>
                  </Actions>
               </Event>
               <!--End Quest 3-->
               
               <!--Quests Reset-->
               <Event EffectTime="OnNewRunStarted">
                  <Conditions>
                     <IsTrue Value="IsAtApocalypseLevelOrMore(ApocMin)"/>
                     <IsTrue Value="IsCityId('RequiredCity')"/>
                     <IsTrue Value="HasBeenQuickstarted = 0"/>
                  </Conditions>
                  <Actions>
                     <SetBufferTo BufferIndex="Buffer" Value="0"/>
                     <SetBufferTo BufferIndex="Buffer2" Value="0"/>
                     <SetBufferTo BufferIndex="Buffer3" Value="0"/>
                  </Actions>
               </Event>
               <Event EffectTime="OnNewRunStarted">
                  <Conditions>
                     <IsTrue Value="IsAtApocalypseLevelOrMore(ApocMin)"/>
                     <IsTrue Value="IsCityId('RequiredCity')"/>
                     <IsTrue Value="HasBeenQuickstarted = 1"/>
                  </Conditions>
                  <Actions>
                     <SetBufferTo BufferIndex="Buffer" Value="Quest1NightsNeeded"/>
                     <SetBufferTo BufferIndex="Buffer2" Value="0"/>
                  </Actions>
               </Event>
               <Event EffectTime="OnNewRunStarted">
                  <Conditions>
                     <IsTrue Value="IsAtApocalypseLevelOrMore(ApocMin)"/>
                     <IsTrue Value="IsCityId('RequiredCity')"/>
                     <IsTrue Value="HasBeenQuickstarted = 2"/>
                  </Conditions>
                  <Actions>
                     <SetBufferTo BufferIndex="Buffer" Value="Quest1NightsNeeded"/>
                     <SetBufferTo BufferIndex="Buffer2" Value="0"/>
                     <SetBufferTo BufferIndex="Buffer3" Value="Quest3MaterialNeeded"/>
                  </Actions>
               </Event>
               <!--Quests Reset End-->
               <!--QuickStart part 1-->
               <Event EffectTime="OnQuickStart">
                  <Conditions>
                     <IsTrue Value="HighestApocalypseReachedOnCity('RequiredCity') > 21"/>
                  </Conditions>
                  <Actions>
                     <SetBufferTo BufferIndex="Buffer" Value="Quest1NightsNeeded"/>
                     <SetBufferTo BufferIndex="Buffer4" Value="1"/>
                  </Actions>
               </Event>
               <!--QuickStart part 2-->
               <Event EffectTime="OnQuickStart">
                  <Conditions>
                     <IsTrue Value="HighestApocalypseReachedOnCity('RequiredCity') > 35"/>
                  </Conditions>
                  <Actions>
                     <SetBufferTo BufferIndex="Buffer" Value="Quest1NightsNeeded"/>
                     <SetBufferTo BufferIndex="Buffer3" Value="Quest3MaterialNeeded"/>
                     <SetBufferTo BufferIndex="Buffer4" Value="2"/>
                  </Actions>
               </Event>
            </Events>
         </BufferModule>
      </Modules>
   </QuestDefinition>

