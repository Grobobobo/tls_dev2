<ResearchConfigurationDefinition xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                     xsi:noNamespaceSchemaLocation="ResearchConfigurationDefinition.xsd">
   
   <!-- Research -->

   <!-- Base Slot -->
   <ResearchSlotGeneration>
      <ResearchSlotPattern Id="BaseLowCost">
         <SlotsAmount>1</SlotsAmount>
         <ResearchConditions>
            <HasAnyTiers>
               <TierId>LowCost</TierId>
            </HasAnyTiers>
         </ResearchConditions>
      </ResearchSlotPattern>

      <ResearchSlotPattern Id="BaseMediumCost">
         <SlotsAmount>1</SlotsAmount>
         <ResearchConditions>
            <HasAnyTiers>
               <TierId>MediumCost</TierId>
            </HasAnyTiers>
         </ResearchConditions>
      </ResearchSlotPattern>

      <ResearchSlotPattern Id="BaseHighCost">
         <SlotsAmount>1</SlotsAmount>
         <ResearchConditions>
            <HasAnyTiers>
               <TierId>HighCost</TierId>
            </HasAnyTiers>
            <HasNoTags>
               <Tag>UniqueWeapon</Tag>
            </HasNoTags>
         </ResearchConditions>
      </ResearchSlotPattern>

      <!-- Low Cost Slot --> <!-- Il faut ajouter les tags d'exclusion des armes-->

      <ResearchSlotPattern Id="LowCost4QuestsActivated">
