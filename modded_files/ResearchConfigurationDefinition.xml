            </HasNoTags>
         </ResearchConditions>
         <UnlockConditions>
            <QuestActivatedAmount Amount="24"/>
         </UnlockConditions>
      </ResearchSlotPattern>

      <!-- Weapons Slot -->

      <ResearchSlotPattern Id="FirstWeaponSlot" NoAvailableResearchTextKeySuffix="Weapon"> <!-- s'unlock après avoir débloqué 1 quete de unique -->
         <SlotsAmount>1</SlotsAmount>
         <ResearchConditions>
            <HasAnyTags>
               <Tag>Weapon</Tag>
            </HasAnyTags>
         </ResearchConditions>
         <UnlockConditions>
            <QuestActivatedAmount Amount="1" LocalizedConditionTextKeySuffix="_UniqueWeapon">
               <QuestConditions>
                  <HasAnyTags>
                     <Tag>UniqueWeapon</Tag>
                  </HasAnyTags>
               </QuestConditions>
            </QuestActivatedAmount>
         </UnlockConditions>
      </ResearchSlotPattern>

      <ResearchSlotPattern Id="SecondWeaponSlot" NoAvailableResearchTextKeySuffix="Weapon">
         <!-- s'unlock après avoir débloqué 3 quetes de unique -->
         <SlotsAmount>1</SlotsAmount>
         <ResearchConditions>
            <HasAnyTags>
               <Tag>Weapon</Tag>
            </HasAnyTags>
         </ResearchConditions>
         <UnlockConditions>
            <QuestActivatedAmount Amount="3" LocalizedConditionTextKeySuffix="_UniqueWeapon">
               <QuestConditions>
                  <HasAnyTags>
                     <Tag>UniqueWeapon</Tag>
                  </HasAnyTags>
               </QuestConditions>
            </QuestActivatedAmount>
         </UnlockConditions>
      </ResearchSlotPattern>

      <ResearchSlotPattern Id="ThirdWeaponSlot" NoAvailableResearchTextKeySuffix="Weapon">
         <!-- s'unlock après avoir débloqué 9 quetes de unique -->
         <SlotsAmount>1</SlotsAmount>
         <ResearchConditions>
            <HasAnyTags>
               <Tag>Weapon</Tag>
            </HasAnyTags>
         </ResearchConditions>
         <UnlockConditions>
            <QuestActivatedAmount Amount="9" LocalizedConditionTextKeySuffix="_UniqueWeapon">
               <QuestConditions>
                  <HasAnyTags>
                     <Tag>UniqueWeapon</Tag>
                  </HasAnyTags>
               </QuestConditions>
            </QuestActivatedAmount>
         </UnlockConditions>
      </ResearchSlotPattern>


      <!-- More Research -->
      <ResearchSlotPattern Id="MoreResearch">
         <GenerateSlotIfNotUnlocked>false</GenerateSlotIfNotUnlocked>
         <SlotsAmount>5</SlotsAmount>
         <UnlockConditions>
            <ResearchCompleted>
               <ResearchId>NewResearches</ResearchId>
            </ResearchCompleted>
         </UnlockConditions>
      </ResearchSlotPattern>
      
      <!--Altar Upgrades-->
      <ResearchSlotPattern Id="AltarUpgrade1">
         <GenerateSlotIfNotUnlocked>false</GenerateSlotIfNotUnlocked>
         <SlotsAmount>3</SlotsAmount>
         <ResearchConditions>
            <HasAnyTiers>
               <TierId>LowCost</TierId>
            </HasAnyTiers>
         </ResearchConditions>
         <UnlockConditions>
            <ResearchSlotPatternFlagToggled Flag="MoreTier1"/>
         </UnlockConditions>
      </ResearchSlotPattern>

      <ResearchSlotPattern Id="AltarUpgrade2">
         <GenerateSlotIfNotUnlocked>false</GenerateSlotIfNotUnlocked>
         <SlotsAmount>3</SlotsAmount>
         <ResearchConditions>
            <HasAnyTiers>
               <TierId>MediumCost</TierId>
            </HasAnyTiers>
         </ResearchConditions>
         <UnlockConditions>
            <ResearchSlotPatternFlagToggled Flag="MoreTier2"/>
         </UnlockConditions>
      </ResearchSlotPattern>

      <ResearchSlotPattern Id="AltarUpgrade3">
         <GenerateSlotIfNotUnlocked>false</GenerateSlotIfNotUnlocked>
         <SlotsAmount>3</SlotsAmount>
         <ResearchConditions>
            <HasAnyTiers>
               <TierId>HighCost</TierId>
            </HasAnyTiers>
         </ResearchConditions>
         <UnlockConditions>
            <ResearchSlotPatternFlagToggled Flag="MoreTier3"/>
         </UnlockConditions>
      </ResearchSlotPattern>

