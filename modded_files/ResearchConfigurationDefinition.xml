      <!-- High Cost Slot -->

      <ResearchSlotPattern Id="HighCost12QuestsActivated">
         <SlotsAmount>1</SlotsAmount>
         <ResearchConditions>
            <HasAnyTiers>
               <TierId>HighCost</TierId>
            </HasAnyTiers>
            <HasNoTags>
