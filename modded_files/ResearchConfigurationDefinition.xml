   </ResearchSlotGeneration>
   
   <ResearchCostFormula>BaseResearchCost * (1 + (ResearchTierCostMultiplier * CompletedResearchAmountPerTier))</ResearchCostFormula>
   
   <!-- Divergences -->
   <DivergenceResearchGain>
      <WeakDivergenceFormula>Difficulty * 0.8</WeakDivergenceFormula>
      <StrongDivergenceFormula>Difficulty * 0.6</StrongDivergenceFormula>
   </DivergenceResearchGain>
   
   <!-- Ordeals -->
   <ObjectiveResearchGain>
      <Formula>Difficulty * 0.12</Formula> <!--Base: 0.15-->
   </ObjectiveResearchGain>
</ResearchConfigurationDefinition>